# --------------------------------------------------------------------------- 
# Punarvasu — Environment Configuration Example 
# --------------------------------------------------------------------------- 
# Copy this file to `.env.local` and fill in real values for local development. 
# 
# cp .env.example .env.local 
# 
# RULES (see docs/SECURITY.md §17): 
# 1. This file contains PLACEHOLDER VALUES ONLY. Never commit real secrets. 
# 2. `NEXT_PUBLIC_*` variables are embedded into the browser bundle at build 
# time. Treat every one of them as public knowledge. 
# 3. Every other variable is SERVER-ONLY and must never be imported into a 
# client component or referenced from client-side code. 
# 4. Variables are read through the typed configuration modules in 
# `src/config/` - `env.public.ts` for browser-safe values and 
# `env.server.ts` for server-only ones - never through scattered 
# `process.env` access. `env.server.ts` imports `server-only`, so a client 
# component that reaches for a secret fails the build. 
# 5. Variables below that no code reads yet are the documented configuration 
# boundary for later phases. The phase that first uses one adds it to the 
# typed configuration then. 
# --------------------------------------------------------------------------- 

# =========================================================================== 
# APPLICATION 
# =========================================================================== 

# Canonical public origin of the application. Used for absolute URLs in 
# metadata, sitemaps, Open Graph tags and email links. 
# PUBLIC — safe for the browser. 
NEXT_PUBLIC_SITE_URL="http://localhost:3000" 

# Deployment environment label used for logging and observability context. 
# One of: development | preview | production 
# SERVER-ONLY. Defaults to "development" when unset. 
# 
# SEARCH INDEXING DEPENDS ON THIS (Phase 20). 
# APP_ENV=production -> robots.txt allows crawling, pages are indexable 
# anything else -> robots.txt disallows everything, every page noindex 
# 
# This is what keeps a preview or staging deployment from competing with 
# production in search results. The consequence is that a PRODUCTION 
# deployment which does not set APP_ENV="production" will tell search engines 
# not to index the clinic's site. Check /robots.txt after the first deploy. 
# See src/lib/seo/indexing.ts. 
APP_ENV="development" 

# Minimum severity written to the structured application log. 
# One of: debug | info | warn | error 
# Defaults to "debug" in development and "info" everywhere else. 
# SERVER-ONLY. 
LOG_LEVEL="debug" 

# =========================================================================== 
# SUPABASE (authentication, PostgreSQL database, storage) 
# =========================================================================== 

# Supabase project URL. 
# PUBLIC — safe for the browser. 
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co" 

# Supabase anonymous/publishable key. 
# PUBLIC — safe for the browser ONLY because Row Level Security is enabled on 
# every table holding user or clinical data. If RLS is missing on a table, this 
# key becomes a data breach. See docs/DATABASE.md §6. 
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key" 

# Supabase service-role key. Bypasses ALL Row Level Security. 
# SERVER-ONLY — CRITICAL SECRET. 
# Never prefix with NEXT_PUBLIC_. Never import into a client component. 
# Use only in trusted server contexts for operations that genuinely cannot be 
# expressed as an RLS-governed user action (see docs/DATABASE.md §6.4). 
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key" 

# =========================================================================== 
# DATABASE (direct connection — migrations and tooling) 
# =========================================================================== 

# Pooled PostgreSQL connection string used by the application runtime. 
# SERVER-ONLY — CRITICAL SECRET. 
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true" 

# Direct (non-pooled) connection string used by migration tooling. 
# SERVER-ONLY — CRITICAL SECRET. 
DIRECT_URL="postgresql://user:password@host:5432/postgres" 

# =========================================================================== 
# EMAIL (transactional notifications) 
# =========================================================================== 

# Verified sender address for transactional email. 
# SERVER-ONLY. 
EMAIL_FROM_ADDRESS="noreply@example.com" 

# Human-readable sender name shown in the recipient's inbox. 
# SERVER-ONLY. 
EMAIL_FROM_NAME="Punarvasu" 

# --------------------------------------------------------------------------- 
# AUTHENTICATION EMAIL (Phase 06) 
# --------------------------------------------------------------------------- 
# Verification and password-reset email is NOT sent by this application and NOT 
# by Supabase's built-in sender, which is limited to a couple of messages an 
# hour and only delivers to members of the Supabase organisation. 
# 
# It is sent by the Edge Function in `supabase/functions/send-auth-email/`, 
# which Supabase Auth calls through its "Send Email" hook. 
# 
# The variables below are therefore **Edge Function secrets, not application 
# environment variables**. They are set with: 
# 
# supabase secrets set NAME=value 
# 
# and are listed here only so the configuration boundary is documented in one 
# place. Nothing in `src/` reads them. See `docs/progress/progress_phase_06.md` 
# for the setup steps and for the trade-offs this provider brings with it. 

# A shared secret between Supabase Auth and the Edge Function. NOT an EmailJS 
# value, and not one you invent for the hosted project. 
# 
# WHERE IT COMES FROM 
# Supabase GENERATES it when the Send Email hook is created, and shows it 
# once. Order matters, because the hook needs a URL to point at: 
# 
# 1. npx supabase functions deploy send-auth-email --no-verify-jwt 
# 2. Dashboard -> Authentication -> Hooks -> Send Email hook -> enable, 
# type HTTPS, URL https://<project-ref>.supabase.co/functions/v1/send-auth-email 
# 3. Copy the generated `v1,whsec_...` value 
# 4. npx supabase secrets set SEND_EMAIL_HOOK_SECRET="v1,whsec_..." 
# 
# `SEND_EMAIL_HOOK_SECRETS` (plural) is accepted too, matching the name of 
# Supabase's own `auth.hook.send_email.secrets` config field. Either name 
# may hold SEVERAL comma-separated secrets, which is how a rotation is done 
# without downtime: add the new one alongside the old, let Supabase switch 
# over, then remove the old. 
# 
# Supabase keeps one copy to sign each call with; the function keeps the 
# other to verify it. They must match exactly, including the `v1,` prefix. 
# Lose it and you regenerate in the dashboard and repeat step 4. 
# 
# For the LOCAL stack (`supabase start`) there is no dashboard, so generate 
# your own and put it in `.env` — `supabase/config.toml` reads it from there: 
# 
# node -e "console.log('v1,whsec_' + require('crypto').randomBytes(32).toString('base64'))" 
# 
# WHY IT MATTERS 
# It is the ONLY authentication on that function. The function is deployed 
# with `verify_jwt = false`, because Supabase signs the call rather than 
# sending a JWT. Without this check the endpoint is an open mail relay that 
# will send from the clinic's address carrying any link a caller chooses. 
# 
# EDGE FUNCTION SECRET — CRITICAL. 
SEND_EMAIL_HOOK_SECRET="v1,whsec_generated-by-supabase-when-the-hook-is-created" 

# EmailJS service and template identifiers, from the EmailJS dashboard. 
# 
# The template needs these parameters: 
# subject, heading, body, action_label, action_url, action_url_plain 
# 
# Its "To Email" field must read the recipient from a parameter. The function 
# sends the address as BOTH `{{email}}` and `{{to_email}}`, so either works - 
# EmailJS gives no useful error when the names disagree, only 
# "422 The recipients address is empty". 
# 
# ONE template serves every authentication action - signup confirmation, 
# password reset, magic link. That is deliberate: the function passes the 
# subject, heading, body and button label as template parameters, so the 
# template is a wrapper and the words live in version control 
# (`supabase/functions/send-auth-email/lib.ts`). 
# 
# Hence `AUTH`, not `WELCOME`: the same template carries the password-reset 
# email, and a "welcome" wrapper around "someone asked to reset your password" 
# is confusing at exactly the moment a patient is judging whether an email 
# about their account is genuine. 
# 
# Application email that is not authentication - appointment confirmations and 
# similar - does not come through this hook. Phase 15 built it, and it has its 
# own configuration below (NOTIFICATIONS_EMAILJS_*). 
# EDGE FUNCTION SECRETS. 
EMAILJS_SERVICE_ID="service_xxxxxxx" 
EMAILJS_AUTH_TEMPLATE_ID="template_xxxxxxx" 

# EmailJS keys. The public key is sent as `user_id` and the private key as 
# `accessToken`; server-side sending needs BOTH, and requires "Allow EmailJS 
# API for non-browser applications" to be enabled in EmailJS security settings. 
# EDGE FUNCTION SECRETS — the private key is a SECRET. 
EMAILJS_PUBLIC_KEY="your-emailjs-public-key" 
EMAILJS_PRIVATE_KEY="your-emailjs-private-key" 

# The application origin the emailed links point at, e.g. https://punarvasu.in 
# Read by the Edge Function. It is configuration, never taken from the request, 
# so a poisoned Host header cannot aim a clinic-branded email elsewhere. 
# EDGE FUNCTION SECRET. 
APP_URL="http://localhost:3000" 

# --------------------------------------------------------------------------- 
# NOTIFICATION EMAIL (Phase 15) 
# --------------------------------------------------------------------------- 
# Transactional notification email - appointment confirmations, reminders, 
# "a prescription is waiting for you". SEPARATE from the authentication email 
# above: that goes through a Supabase Auth hook and never touches the 
# application; this is sent by the notification worker inside the app. 
# 
# ALL FOUR OR NONE. `getNotificationEmailConfig()` returns null unless every 
# value is present, and the email channel then does not exist: no delivery 
# rows are created, nothing accumulates in a queue that will never drain, and 
# the preferences screen says email is not switched on. Three of four is not a 
# half-working channel, it is no channel. 
# 
# Leaving these unset is a supported configuration. In-app notifications work 
# regardless - the notification row IS the in-app delivery. 
# 
# The EmailJS template needs these parameters: 
# subject, heading, body, action_label, action_url, action_url_plain, 
# from_name 
# and its "To Email" field must read the recipient from a parameter; the 
# worker sends the address as BOTH {{email}} and {{to_email}}. 
# 
# Use a template distinct from the authentication one: an appointment 
# confirmation and a password reset want different wording, and the auth 
# template lives behind an Edge Function that this code cannot reach. 
# 
# SERVER-ONLY. The private key is a SECRET. Read only by 
# `src/lib/notifications/providers/emailjs.ts`, which imports `server-only`. 
NOTIFICATIONS_EMAILJS_SERVICE_ID="" 
NOTIFICATIONS_EMAILJS_TEMPLATE_ID="" 
NOTIFICATIONS_EMAILJS_PUBLIC_KEY="" 
NOTIFICATIONS_EMAILJS_PRIVATE_KEY="" 

# The shared secret that authenticates POST /api/notifications/process. 
# 
# WHY IT MATTERS 
# That endpoint drains the notification queue and sends email. When this is 
# UNSET the endpoint refuses EVERY request - it does not default to open. 
# Generate at least 16 characters: 
# 
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))" 
# 
# WHAT HAS TO CALL IT 
# Reminders and delivery retries need a scheduler. Without one the reminder 
# machinery is correct and idle: an opportunistic drain runs only when 
# somebody happens to do something in the application, and a reminder due at 
# four in the morning has nobody to wake it. 
# 
# Vercel Cron - vercel.json: 
# { "crons": [{ "path": "/api/notifications/process", 
# "schedule": "*/5 * * * *" }] } 
# (Vercel Cron cannot set a header; front it with a route that adds one, 
# or use an external scheduler.) 
# 
# Supabase pg_cron: 
# select cron.schedule('punarvasu-notifications', '*/5 * * * *', $$ 
# select net.http_post( 
# url := 'https://<host>/api/notifications/process', 
# headers := '{"authorization":"Bearer <secret>"}'::jsonb) $$); 
# 
# Anything else: 
# curl -X POST -H "authorization: Bearer <secret>" <url> 
# 
# SERVER-ONLY - SECRET. 
NOTIFICATIONS_WORKER_SECRET="" 

# =========================================================================== 
# STORAGE (patient documents and reports) 
# =========================================================================== 

# Name of the PRIVATE Supabase Storage bucket holding patient documents. 
# This bucket must never be public. Access is granted only through 
# short-lived signed URLs issued after a server-side authorization check. 
# See docs/DATABASE.md §9. 
# SERVER-ONLY. 
STORAGE_PATIENT_DOCUMENTS_BUCKET="patient-documents" 

# Lifetime, in seconds, of signed download URLs for patient documents. 
# Keep this short. Long-lived URLs are effectively public links. 
# SERVER-ONLY. 
STORAGE_SIGNED_URL_TTL_SECONDS="120" 

# Maximum accepted upload size in bytes. 
# SERVER-ONLY. 
STORAGE_MAX_UPLOAD_BYTES="10485760" 

# =========================================================================== 
# AI (clinical decision SUPPORT only — never autonomous clinical action) 
# =========================================================================== 
# Constraints on AI use are non-negotiable and defined in 
# docs/HEALTHCARE_AND_AI_SAFETY.md. AI must never diagnose, prescribe, or 
# write final clinical records without practitioner review. 

# Which provider to call. 
# gemini the configured model, over HTTPS 
# mock a deterministic stub. No key, no network. Use it for local 
# development and tests so that synthetic patients are never sent to 
# a production model (phase_17.md sections 65, 121). 
# Defaults to "gemini" when unset. 
# SERVER-ONLY. 
AI_PROVIDER="mock" 

# AI provider API key. 
# SERVER-ONLY - SECRET. Never call an AI provider directly from the browser. 
# Not required when AI_PROVIDER=mock. 
AI_PROVIDER_API_KEY="your-provider-api-key" 

# Model identifier used for practitioner-facing assistive features. 
# Recorded against every invocation, because changing it can change clinical 
# behaviour (phase_17.md section 124). 
# SERVER-ONLY. 
AI_MODEL="your-model-id" 

# Master switch for clinical AI. 
# 
# DISABLED BY DEFAULT, and only the exact string "true" enables it. Anything 
# else - "1", "yes", a typo, an empty value, an absent variable - means off, 
# so a misconfigured or partially deployed environment never silently enables 
# AI in a clinical setting (docs/HEALTHCARE_AND_AI_SAFETY.md section 9). 
# 
# It controls AVAILABILITY, never authorization (phase_17.md section 161). 
# Switching it on gives nobody AI: a doctor still needs the clinical_ai.use 
# permission, a practitioner record, and an appointment of their own, and the 
# database re-checks every one of them. 
# 
# A deployment with this on but no key, or a key but no model, gets no AI 
# rather than a feature that fails on every request. 
# SERVER-ONLY. 
CLINICAL_AI_ENABLED="false" 

# =========================================================================== 
# ANALYTICS AND OBSERVABILITY 
# =========================================================================== 
# Analytics must never receive patient-identifying or clinical information. 
# See docs/SECURITY.md §15 and docs/HEALTHCARE_AND_AI_SAFETY.md §4. 

# Error/performance monitoring DSN. 
# PUBLIC if the provider's browser SDK is used — must be a client-safe DSN. 
NEXT_PUBLIC_MONITORING_DSN="" 

# Privacy-respecting web analytics site identifier. 
# PUBLIC. 
NEXT_PUBLIC_ANALYTICS_SITE_ID="" 

# =========================================================================== 
# EXTERNAL INTEGRATIONS (not implemented — reserved for later phases) 
# =========================================================================== 
# Listed so the configuration boundary exists before the features arrive. 
# Leave blank until the corresponding phase is implemented. 

# WhatsApp / SMS notification provider credentials. 
# 
# STILL NOT IMPLEMENTED after Phase 15, deliberately. No such channel exists 
# anywhere in the system: not in `public.notification_channel`, not in 
# `NOTIFICATION_CHANNELS`, and not as an adapter — `phase_15.md` section 14 
# forbids pretending an unconfigured channel works, and section 101 requires 
# provider capability, consent, sender registration and template approval to 
# be settled before one could be. 
# 
# Adding one is: a provider adapter implementing `NotificationChannelAdapter`, 
# an entry in `resolveChannels()`, and TWO migrations (PostgreSQL will not let 
# an enum value added by `alter type ... add value` be used in the same 
# transaction). 
# SERVER-ONLY — SECRET. 
MESSAGING_PROVIDER_API_KEY="" 

# Payment gateway credentials. 
# SERVER-ONLY — SECRET. 
PAYMENT_PROVIDER_KEY_ID="" 
PAYMENT_PROVIDER_KEY_SECRET="" 

# Signing secret used to verify inbound webhooks. 
# SERVER-ONLY — SECRET. 
WEBHOOK_SIGNING_SECRET=""