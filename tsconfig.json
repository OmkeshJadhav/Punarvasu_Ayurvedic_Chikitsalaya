{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // `supabase/functions/*/index.ts` is Deno, not Node: it uses `Deno.serve`
  // and `Deno.env`, which do not exist in this lib set. Its logic lives in
  // `lib.ts`, which is plain TypeScript and *is* typechecked - it is pulled
  // into the program by `tests/integration/auth-email-hook.test.ts`.
  "exclude": ["node_modules", "supabase/functions/**/index.ts"]
}
